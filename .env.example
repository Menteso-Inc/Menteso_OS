# ===========================================
# Menteso Virtual Office — Environment Config
# ===========================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# -- LLM Providers --
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# -- Agent-specific keys --
# Add keys below as new agents are created.
# Use the naming convention: {AGENT_NAME}_{SERVICE}_{KEY_TYPE}
# Example:
# EMAIL_AGENT_GMAIL_TOKEN=your_gmail_token_here
# RESEARCH_AGENT_SERP_KEY=your_serp_api_key_here

# -- PatentZoom SEO Agent --
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CONTENT_LLM_PROVIDER=anthropic
WP_BASE_URL=https://www.patentzoom.us
WP_USERNAME=
WP_APPLICATION_PASSWORD=
AUTO_PUBLISH=false
SITE_NAME=PatentZoom
BRAND_TONE=Professional, authoritative, practical, helpful
DEFAULT_CATEGORY=Patent Filing
DEFAULT_AUTHOR=
ENABLE_FEATURED_IMAGE=true
ENABLE_GOOGLE_INDEXING=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_TOKEN_EXPIRY=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:patentzoom.us
SERPAPI_API_KEY=

# -- PatentZoom AI SEO Platform --
# Control API storage and queue
SEO_DATABASE_URL=sqlite:///./services/seo-control-api/patentzoom_seo.db
SEO_REDIS_URL=redis://127.0.0.1:6379/0
SEO_CONTROL_API_BASE_URL=http://127.0.0.1:8100
SEO_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# Frontend
NEXT_PUBLIC_SEO_API_BASE_URL=http://127.0.0.1:8100

# -- CAPTCHA Solver (sub-agent of PCT Agent) --
# Lives at agents/pct_agent/captcha_solver/; not a top-level dashboard agent.
# Tier order, comma-separated. Set to "manual" only to disable all auto-solving.
# Available tiers: diy, openai, manual
CAPTCHA_SOLVER_TIERS=diy,openai,manual
CAPTCHA_SOLVER_MAX_SECONDS=120
CAPTCHA_SOLVER_MAX_ATTEMPTS=3
# Tier 2 reuses OPENAI_API_KEY declared above.
CAPTCHA_SOLVER_OPENAI_MODEL=gpt-4o
# Save every encountered captcha image + answer to logs/pct_agent/captcha_solver/samples/
# for future training of a local model. Set to false to opt out.
CAPTCHA_SOLVER_SAVE_SAMPLES=true

# -- Tier 0: Prevention (free, no service required) --
# Min delay between WIPO requests (seconds) + random jitter on top.
# Defaults tuned for ~50-150 rows/min. Raise both values if you want to be
# easier on the WIPO server at the cost of throughput.
PACING_MIN_DELAY_SECONDS=0.3
PACING_JITTER_SECONDS=0.3
# Delay multiplier for the first N requests after a captcha was just solved.
PACING_POST_CAPTCHA_MULTIPLIER=3.0
PACING_BOOST_REQUESTS=5

# -- PCT Agent speed knobs --
# WARNING: both flags below are EXPERIMENTAL. The defaults below are the
# proven-working configuration. Only flip these to "true" after you've
# tested each on a small batch (~20 rows) and confirmed the agent still
# scrapes correctly. If you see every row return "not_found", flip the
# flag you most recently enabled back to "false".

# Headless worker mode (default = true). The scraping worker runs without
# a visible Chromium window. If a captcha defeats DIY OCR + GPT-4o Vision,
# the manual_fallback tier opens a separate VISIBLE Chromium popup so you
# can solve the challenge — it transfers cookies in & out and closes the
# popup automatically once the captcha clears. Set to false to keep the
# worker itself visible (useful only when debugging Playwright behavior).
PCT_HEADLESS_MODE=true

# Opt-in parallel pipeline mode (multiple browsers running in parallel).
# Default = sequential chunked (one browser, proven mode). Parallel mode
# can be ~3× faster but is more aggressive against WIPO; try it on a
# small batch (20-50 rows) first before running a large file.
PCT_FAST_MODE=false

# Pool-mode bandwidth saver — blocks images/CSS/fonts on parallel browsers.
# When enabled, each row uses ~70% less bandwidth, BUT it has been observed
# to make WIPO return empty Documents tabs (every row → not_found). Stay
# OFF unless you've verified it works for your setup.
PCT_POOL_BLOCK_RESOURCES=false

# -- Optional free IP rotation via Tor --
# Enable only if Tor is installed locally and listens on 127.0.0.1:9050.
# (On Windows: launch Tor Browser bundle. On Linux: sudo systemctl start tor.)
TOR_ENABLED=false
TOR_SOCKS_PROXY=socks5://127.0.0.1:9050

# -- Optional paid IP rotation (slot for future use) --
# Comma-separated proxy URLs. Format: http://user:pass@host:port
# Leave blank to disable; pacing alone is the default prevention strategy.
PROXY_POOL_URLS=
PROXY_POOL_BURN_COOLDOWN_SECONDS=300
