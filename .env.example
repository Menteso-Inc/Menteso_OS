# -- Social Posting --
# Meta Graph version to use for Facebook and Instagram.
META_GRAPH_API_VERSION=v23.0
# LinkedIn REST version in YYYYMM format.
LINKEDIN_API_VERSION=202605
# Global content preferences for social sharing.
SOCIAL_USE_FEATURED_IMAGE=true
SOCIAL_USE_HASHTAGS=true

# -- CAPTCHA Solver (sub-agent of PCT Agent) --
# Lives at agents/pct_agent/captcha_solver/; not a top-level dashboard agent.
# Tier order, comma-separated. Set to "manual" only to disable all auto-solving.
# Available tiers: diy, openai, manual
CAPTCHA_SOLVER_TIERS=diy,openai,manual
CAPTCHA_SOLVER_MAX_SECONDS=120
CAPTCHA_SOLVER_MAX_ATTEMPTS=3
# Tier 2 reuses OPENAI_API_KEY declared above.
CAPTCHA_SOLVER_OPENAI_MODEL=gpt-4o
# Save every encountered captcha image + answer to logs/pct_agent/captcha_solver/samples/
# for future training of a local model. Set to false to opt out.
CAPTCHA_SOLVER_SAVE_SAMPLES=true

# -- Tier 0: Prevention (free, no service required) --
# Min delay between WIPO requests (seconds) + random jitter on top.
# Defaults tuned for ~50-150 rows/min. Raise both values if you want to be
# easier on the WIPO server at the cost of throughput.
PACING_MIN_DELAY_SECONDS=0.3
PACING_JITTER_SECONDS=0.3
# Delay multiplier for the first N requests after a captcha was just solved.
PACING_POST_CAPTCHA_MULTIPLIER=3.0
PACING_BOOST_REQUESTS=5

# -- PCT Agent speed knobs --
# WARNING: both flags below are EXPERIMENTAL. The defaults below are the
# proven-working configuration. Only flip these to "true" after you've
# tested each on a small batch (~20 rows) and confirmed the agent still
# scrapes correctly. If you see every row return "not_found", flip the
# flag you most recently enabled back to "false".

# Headless worker mode (default = true). The scraping worker runs without
# a visible Chromium window. If a captcha defeats DIY OCR + GPT-4o Vision,
# the manual_fallback tier opens a separate VISIBLE Chromium popup so you
# can solve the challenge — it transfers cookies in & out and closes the
# popup automatically once the captcha clears. Set to false to keep the
# worker itself visible (useful only when debugging Playwright behavior).
PCT_HEADLESS_MODE=true

# Opt-in parallel pipeline mode (multiple browsers running in parallel).
# Default = sequential chunked (one browser, proven mode). Parallel mode
# can be ~3× faster but is more aggressive against WIPO; try it on a
# small batch (20-50 rows) first before running a large file.
PCT_FAST_MODE=false

# -- PCT continuous gazette scheduler --
# Seed queue for automated WIPO weekly browse runs. The scheduler normalizes
# 28-2025 to 28/2025 before passing it to the WIPO downloader.
PCT_SCHEDULER_GAZETTES=28/2025,29/2025,30/2025
# true = after the highest queued gazette finishes/fails, append the next
# gazette number so the worker keeps moving continuously.
PCT_SCHEDULER_CONTINUE_SEQUENCE=true
PCT_SCHEDULER_MAX_ATTEMPTS=3
PCT_SCHEDULER_RETRY_DELAY_SECONDS=300
PCT_SCHEDULER_RUN_DELAY_SECONDS=30
PCT_SCHEDULER_IDLE_DELAY_SECONDS=900
PCT_SCHEDULER_STATE_FILE=

# Pool-mode bandwidth saver — blocks images/CSS/fonts on parallel browsers.
# When enabled, each row uses ~70% less bandwidth, BUT it has been observed
# to make WIPO return empty Documents tabs (every row → not_found). Stay
# OFF unless you've verified it works for your setup.
PCT_POOL_BLOCK_RESOURCES=false

# -- PCT completion email --
# Sends a compact summary and the generated Work Report attachment after a PCT run.
# The sheet/contact rows are not stored in the database.
PCT_EMAIL_ENABLED=false
PCT_EMAIL_SMTP_HOST=smtp.gmail.com
PCT_EMAIL_SMTP_PORT=587
PCT_EMAIL_SMTP_USER=it@menteso.com
PCT_EMAIL_SMTP_PASSWORD=
PCT_EMAIL_FROM=it@menteso.com
PCT_EMAIL_TO=sajan@menteso.com,shweta@menteso.com,it@menteso.com
PCT_EMAIL_MAX_ATTACHMENT_MB=20

# -- Free multi-IP rotation via Tor (each browser tab = its own exit IP) --
# Set TOR_ENABLED=true to route each PCT browser worker through a different Tor
# circuit, spreading WIPO's per-IP throttling across many IPs. Requires Tor
# running with multiple SOCKS ports — the pct-tor pm2 app (ecosystem.config.js)
# starts one with 12 ports (9050-9061) from .tor/torrc.
# NOTE: Tor exit IPs are often blocklisted by WIPO; this is best for TESTING the
# rotation plumbing for free. For reliable 2000 rows/hr use paid residential
# proxies via PROXY_POOL_URLS below (same code path, just swap the source).
TOR_ENABLED=false
# Preferred: a base port + how many ports Tor exposes (must match .tor/torrc).
TOR_SOCKS_BASE_PORT=9050
TOR_SOCKS_PORT_COUNT=12
# Or list explicit ports instead: TOR_SOCKS_PORTS=9050,9051,9052
# Or a single endpoint (back-compat): TOR_SOCKS_PROXY=socks5://127.0.0.1:9050

# -- Paid IP rotation (recommended for real throughput) --
# Comma-separated proxy URLs. Format: http://user:pass@host:port or socks5://host:port
# Each worker is assigned one round-robin, so give ~15-20 entries (or a
# backconnect gateway with per-session usernames) for the 2000 rows/hr target.
# Takes priority over Tor when set.
PROXY_POOL_URLS=
PROXY_POOL_BURN_COOLDOWN_SECONDS=300

# -- Dashboard deployment --
# Use 0.0.0.0 so other machines can reach the dashboard through this server.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# PCT contact verification: reuse the shared OPENAI_API_KEY by default.
# Select openai or ollama; Ollama uses only the local vision server below.
PCT_AI_PROVIDER=openai
PCT_OLLAMA_BASE_URL=http://127.0.0.1:11434
PCT_OLLAMA_MODEL=qwen3.5:4b
# Optional pin from local /api/tags. A changed model then blocks the run.
PCT_OLLAMA_MODEL_DIGEST=
# Full original PDF images and the existing 7,000-token output allowance.
PCT_OLLAMA_CONTEXT_LENGTH=65536
PCT_OLLAMA_TIMEOUT_SECONDS=1800
PCT_OLLAMA_NUM_THREADS=4
# Experimental CPU document verification. Enable only after a blind local test.
PCT_OLLAMA_DOCUMENT_MODE=full_pages
# source_regions only; requires requirements-pct-local-ocr.txt and local models.
PCT_OLLAMA_SECONDARY_OCR=false
# CPU-only pilot: PCT_PDF_VERIFICATION_WORKERS=1, PCT_PDF_API_CONCURRENCY=1,
# PCT_PIPELINE_PENDING_PDFS=2. Both readings still run; no OpenAI fallback.
PCT_AI_VERIFY_ENABLED=true
PCT_AI_MODEL=gpt-4o
# Check email-domain mail routing; this does not verify mailbox existence.
PCT_EMAIL_DNS_CHECK=true
INVOICE_REMINDER_PORTAL_SECRET=
INVOICE_REMINDER_STRIPE_SECRET_KEY=
INVOICE_REMINDER_STRIPE_WEBHOOK_SECRET=

# PCT image-based contact verification; reuse shared OPENAI_API_KEY.
PCT_AI_VERIFY_ENABLED=true
PCT_AI_MODEL=gpt-4o
PCT_OPENAI_API_KEY=
# Optional rules/evidence paths; blank uses PCT-local defaults.
PCT_AI_RULES_FILE=
PCT_AI_EVIDENCE_DIR=
PCT_AI_MAX_PAGES=5

# Single-browser pipeline: pending downloaded PDFs, including the active verifier.
# Both independent image readings are retained; one worker uses a two-request cap.
PCT_PIPELINE_PENDING_PDFS=2
# PDF processing only; WIPO still uses one browser at its existing pace.
# Set 4 workers and 8 pending PDFs for bounded parallel verification.
PCT_PDF_VERIFICATION_WORKERS=1
# Shared across all PDF processes, including focused accuracy rereads (1-8).
PCT_PDF_API_CONCURRENCY=8
# Minimum seconds between patent lookups (1-60); failures increase the backoff.
PCT_PIPELINE_MIN_ROW_INTERVAL_SECONDS=10

# Optional future reuse: preserved WLF n8n credential, not automatically loaded
# by Lexmom. Obtain from the private n8n_wlf/credential-vault/.env on Menteso OS.
# See docs/lexmom_sub_manager/N8N_WLF_MIGRATION_20261009.md before selecting it.
WLF_SDR_OPENAI_API_KEY=

# -- Lexmom SES transport setup (campaign sending stays disabled) --
