# ===========================================
# Menteso Virtual Office — Environment Config
# ===========================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# -- LLM Providers --
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# -- Agent-specific keys --
# Add keys below as new agents are created.
# Use the naming convention: {AGENT_NAME}_{SERVICE}_{KEY_TYPE}
# Example:
# EMAIL_AGENT_GMAIL_TOKEN=your_gmail_token_here
# RESEARCH_AGENT_SERP_KEY=your_serp_api_key_here

# -- PatentZoom SEO Agent --
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CONTENT_LLM_PROVIDER=anthropic
WP_BASE_URL=https://www.patentzoom.us
WP_USERNAME=
WP_APPLICATION_PASSWORD=
AUTO_PUBLISH=false
SITE_NAME=PatentZoom
BRAND_TONE=Professional, authoritative, practical, helpful
DEFAULT_CATEGORY=Patent Filing
DEFAULT_AUTHOR=
ENABLE_FEATURED_IMAGE=true
ENABLE_GOOGLE_INDEXING=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_TOKEN_EXPIRY=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:patentzoom.us
SERPAPI_API_KEY=
PATENTZOOM_SOCIAL_AUTO_POST=false
PATENTZOOM_SOCIAL_PLATFORMS=facebook,instagram,linkedin
PATENTZOOM_SOCIAL_FACEBOOK_PAGE_ID=
PATENTZOOM_SOCIAL_META_ACCESS_TOKEN=
PATENTZOOM_SOCIAL_INSTAGRAM_BUSINESS_ACCOUNT_ID=
PATENTZOOM_SOCIAL_LINKEDIN_ORGANIZATION_URN=
PATENTZOOM_SOCIAL_LINKEDIN_ACCESS_TOKEN=

# -- Patent Drawing Experts SEO Workspace --
PATENT_DRAWING_EXPERTS_WP_BASE_URL=
PATENT_DRAWING_EXPERTS_WP_USERNAME=
PATENT_DRAWING_EXPERTS_WP_APPLICATION_PASSWORD=
PATENT_DRAWING_EXPERTS_AUTO_PUBLISH=false
PATENT_DRAWING_EXPERTS_SITE_NAME=Patent Drawing Experts
PATENT_DRAWING_EXPERTS_BRAND_TONE=Professional, precise, practical, educational, patent-illustration focused
PATENT_DRAWING_EXPERTS_DEFAULT_CATEGORY=Article
PATENT_DRAWING_EXPERTS_DEFAULT_AUTHOR=
PATENT_DRAWING_EXPERTS_ENABLE_FEATURED_IMAGE=true
PATENT_DRAWING_EXPERTS_ENABLE_GOOGLE_INDEXING=false
PATENT_DRAWING_EXPERTS_GOOGLE_SERVICE_ACCOUNT_JSON=
PATENT_DRAWING_EXPERTS_GOOGLE_SEARCH_CONSOLE_PROPERTY=
PATENT_DRAWING_EXPERTS_SOCIAL_AUTO_POST=false
PATENT_DRAWING_EXPERTS_SOCIAL_PLATFORMS=facebook,linkedin
PATENT_DRAWING_EXPERTS_SOCIAL_FACEBOOK_PAGE_ID=
PATENT_DRAWING_EXPERTS_SOCIAL_META_ACCESS_TOKEN=
PATENT_DRAWING_EXPERTS_SOCIAL_INSTAGRAM_BUSINESS_ACCOUNT_ID=
PATENT_DRAWING_EXPERTS_SOCIAL_LINKEDIN_ORGANIZATION_URN=
PATENT_DRAWING_EXPERTS_SOCIAL_LINKEDIN_ACCESS_TOKEN=

# -- IP Docketers SEO Workspace --
IP_DOCKETERS_WP_BASE_URL=
IP_DOCKETERS_WP_USERNAME=
IP_DOCKETERS_WP_APPLICATION_PASSWORD=
IP_DOCKETERS_AUTO_PUBLISH=false
IP_DOCKETERS_SITE_NAME=IP Docketers
IP_DOCKETERS_BRAND_TONE=Professional, clear, operations-aware, intellectual-property workflow focused
IP_DOCKETERS_DEFAULT_CATEGORY=Article
IP_DOCKETERS_DEFAULT_AUTHOR=
IP_DOCKETERS_ENABLE_FEATURED_IMAGE=true
IP_DOCKETERS_ENABLE_GOOGLE_INDEXING=false
IP_DOCKETERS_GOOGLE_SERVICE_ACCOUNT_JSON=
IP_DOCKETERS_GOOGLE_SEARCH_CONSOLE_PROPERTY=
IP_DOCKETERS_SOCIAL_AUTO_POST=false
IP_DOCKETERS_SOCIAL_PLATFORMS=facebook,linkedin
IP_DOCKETERS_SOCIAL_FACEBOOK_PAGE_ID=
IP_DOCKETERS_SOCIAL_META_ACCESS_TOKEN=
IP_DOCKETERS_SOCIAL_INSTAGRAM_BUSINESS_ACCOUNT_ID=
IP_DOCKETERS_SOCIAL_LINKEDIN_ORGANIZATION_URN=
IP_DOCKETERS_SOCIAL_LINKEDIN_ACCESS_TOKEN=

# -- Menteso SEO Workspace --
MENTESO_WP_BASE_URL=
MENTESO_WP_USERNAME=
MENTESO_WP_APPLICATION_PASSWORD=
MENTESO_AUTO_PUBLISH=false
MENTESO_SITE_NAME=Menteso
MENTESO_BRAND_TONE=Professional, modern, operations-minded, AI automation focused
MENTESO_DEFAULT_CATEGORY=Article
MENTESO_DEFAULT_AUTHOR=
MENTESO_ENABLE_FEATURED_IMAGE=true
MENTESO_ENABLE_GOOGLE_INDEXING=false
MENTESO_GOOGLE_SERVICE_ACCOUNT_JSON=
MENTESO_GOOGLE_SEARCH_CONSOLE_PROPERTY=
MENTESO_SOCIAL_AUTO_POST=false
MENTESO_SOCIAL_PLATFORMS=facebook,linkedin
MENTESO_SOCIAL_FACEBOOK_PAGE_ID=
MENTESO_SOCIAL_META_ACCESS_TOKEN=
MENTESO_SOCIAL_INSTAGRAM_BUSINESS_ACCOUNT_ID=
MENTESO_SOCIAL_LINKEDIN_ORGANIZATION_URN=
MENTESO_SOCIAL_LINKEDIN_ACCESS_TOKEN=

# -- Social Posting --
# Meta Graph version to use for Facebook and Instagram.
META_GRAPH_API_VERSION=v23.0
# LinkedIn REST version in YYYYMM format.
LINKEDIN_API_VERSION=202605
# Global content preferences for social sharing.
SOCIAL_USE_FEATURED_IMAGE=true
SOCIAL_USE_HASHTAGS=true

# -- PatentZoom AI SEO Platform --
# Control API storage and queue
SEO_DATABASE_URL=sqlite:///./services/seo-control-api/patentzoom_seo.db
SEO_REDIS_URL=redis://127.0.0.1:6379/0
SEO_CONTROL_API_BASE_URL=http://127.0.0.1:8100
SEO_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# Frontend
NEXT_PUBLIC_SEO_API_BASE_URL=http://127.0.0.1:8100
