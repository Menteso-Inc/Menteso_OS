# ===========================================
# Menteso Virtual Office — Environment Config
# ===========================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# -- LLM Providers --
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
DEFAULT_LLM_MODEL=gpt-4o

# -- Public server URLs --
# Public Cloudflare/custom-domain base URL for OAuth callbacks and browser-facing links.
PUBLIC_BASE_URL=
APP_BASE_URL=
CLOUDFLARE_TUNNEL_URL=
GOOGLE_OAUTH_REDIRECT_URI=
META_OAUTH_REDIRECT_URI=
LINKEDIN_OAUTH_REDIRECT_URI=
NEXT_PUBLIC_SEO_API_BASE_URL=
SEO_CONTROL_API_BASE_URL=
SEO_ALLOWED_ORIGINS=

# -- Dashboard Runtime --
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8010

# -- Agent-specific keys --
# Add keys below as new agents are created.
# Use the naming convention: {AGENT_NAME}_{SERVICE}_{KEY_TYPE}
# Example:
# EMAIL_AGENT_GMAIL_TOKEN=your_gmail_token_here
# RESEARCH_AGENT_SERP_KEY=your_serp_api_key_here

# -- PatentZoom SEO Agent --
OPENAI_MODEL=gpt-4.1-mini
