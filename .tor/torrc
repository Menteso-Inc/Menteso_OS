# Tor config for PCT agent — multiple SOCKS ports = multiple concurrent exit IPs.
# Each SocksPort has its own SessionGroup so Tor keeps them on independent
# circuits (independent exit relays / IPs). Generated; safe to edit COUNT below.
DataDirectory C:\sites\Menteso_OS\.tor\data
Log notice file C:\sites\Menteso_OS\.tor\tor.log
# Recycle circuits so exit IPs refresh over time (helps dodge per-IP throttling).
MaxCircuitDirtiness 90
NewCircuitPeriod 45
# Faster startup: don't need guards persistence pinned hard.

SocksPort 127.0.0.1:9050 SessionGroup=1
SocksPort 127.0.0.1:9051 SessionGroup=2
SocksPort 127.0.0.1:9052 SessionGroup=3
